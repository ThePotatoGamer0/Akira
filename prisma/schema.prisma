generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum CardQuality {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum CooldownType {
  GRAB
  DROP
  DAILY
}

model Series {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique
  characters Character[]
  trackedBy  TrackedSeries[]
}

model Character {
  id          String        @id @default(cuid())
  name        String
  slug        String
  seriesId    String
  description String?
  gender      String?
  /** AniList MAIN or SUPPORTING. Unset characters are not treated as main. */
  role        String?
  aliases     String?       // Stored as stringified JSON array
  series      Series        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  variants    CardVariant[]
  wishlists   Wishlist[]

  @@unique([seriesId, slug])
}

model CardVariant {
  id           String        @id
  characterId  String
  character    Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name         String
  rarity       String
  image        String
  cards        Card[]
  dropSlots    DropSlot[]
  printCounter PrintCounter?
}

model Card {
  id          String      @id
  variantId   String
  variant     CardVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /** Null uses the server's default frame. A number is a frame chosen for this card. */
  frameId     Int?
  printNumber Int
  quality     CardQuality
  ownerId     String?
  owner       User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /** Name of a tag this owner created. Null cards show ◾. */
  tag         String?
  alias       String?
  dye         String?
  obtainedAt  DateTime    @default(now())
  dropSlot    DropSlot?

  @@index([ownerId])
  @@index([variantId, frameId])
}

model User {
  id                  String                 @id @default(cuid())
  discordId           String                 @unique
  /** Cached Discord login handle for WebUI username lookup (friend-group scale). */
  discordUsername     String?                @unique
  /** What Akira calls you in WebUI copy and bot greetings (falls back to Discord handle). */
  preferredName       String?
  passwordHash        String?
  isAdmin             Boolean                @default(false)
  bits                Int                    @default(0)
  prestigeLevel       Int                    @default(0)
  milestoneCount      Int                    @default(0)
  milestoneProgress   Int                    @default(0)
  passiveBitsBonus    Int                    @default(0)
  /** Card code from the player's latest successful grab. Bare `av` opens this. */
  lastGrabbedCardId   String?
  /** Drops in a row with no mint. The 200th forces one, then this goes back to 0. */
  dropsSinceMint      Int                    @default(0)
  /** Frame for this player's cards that don't have one of their own. Null uses the server frame. */
  defaultFrameId      Int?
  cards               Card[]
  wishlists           Wishlist[]
  poolContributions   UserPoolContribution[]
  inventory           Inventory[]
  cooldowns           Cooldown[]
  reminders           Reminder[]
  claimedSlots        DropSlot[]
  drops               Drop[]
  transfersSent       TransferOffer[] @relation("TransferFrom")
  transfersReceived   TransferOffer[] @relation("TransferTo")
  multitradesSent     Multitrade[]    @relation("MultitradeFrom")
  multitradesReceived Multitrade[]    @relation("MultitradeTo")
  multitradeEntries   MultitradeEntry[]
  tags                Tag[]
  trackedSeries       TrackedSeries[]
  buffs               Buff[]
  prestigeBuffs       PrestigeBuff[]
}

model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  emoji  String

  @@unique([userId, name])
  @@index([userId])
}

/** Up to four series a player pinned on the stats completion card. */
model TrackedSeries {
  userId   String
  seriesId String
  /** Lower numbers show first. */
  position Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
  @@unique([userId, position])
}

model Wishlist {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
}

model Buff {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  expiresAt DateTime
  seriesId  String?

  @@unique([userId, kind])
  @@index([userId])
}

model PrestigeBuff {
  userId String
  kind   String
  stacks Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
}

/** One row. The shop's featured series for a UTC day, so a restart does not reshuffle it. */
model FeaturedSeries {
  id       String @id
  day      String
  seriesId String
}

model ServerPool {
  id         String    @id @default(cuid())
  guildId    String    @unique
  totalBits  Int       @default(0)
  lastReset  DateTime?
  activeBuff String?
  buffTier   Int       @default(0)
  buffExpiry DateTime?
}

model UserPoolContribution {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  guildId String
  bits    Int
  date    String

  @@index([userId, guildId, date])
}

model Inventory {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType String
  quantity Int    @default(1)

  @@unique([userId, itemType])
  @@index([userId])
}

model Cooldown {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      CooldownType
  expiresAt DateTime

  @@unique([userId, type])
}

model Reminder {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   CooldownType

  @@unique([userId, type])
}

model TransferOffer {
  id            String   @id
  kind          String
  fromUserId    String
  fromUser      User     @relation("TransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId      String
  toUser        User     @relation("TransferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  fromCardId    String
  toCardId      String?
  fromConfirmed Boolean  @default(false)
  toConfirmed   Boolean  @default(false)
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  @@index([status, fromCardId])
  @@index([status, toCardId])
}

model Multitrade {
  id          String            @id
  guildId     String
  channelId   String
  messageId   String?
  fromUserId  String
  fromUser    User              @relation("MultitradeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User              @relation("MultitradeTo", fields: [toUserId], references: [id], onDelete: Cascade)
  /** request, open, done, cancelled, or expired. */
  status      String            @default("request")
  fromLocked  Boolean           @default(false)
  toLocked    Boolean           @default(false)
  closeReason String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  entries     MultitradeEntry[]

  @@index([status, channelId])
  @@index([fromUserId, status])
  @@index([toUserId, status])
}

model MultitradeEntry {
  id        String     @id @default(cuid())
  tradeId   String
  trade     Multitrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String?
  bits      Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([tradeId, userId])
  @@index([cardId])
}

model GuildConfig {
  guildId       String  @id
  dropChannelId String?
  /** Also accept Karuta's k and k! prefixes. Incompatible with Karuta on those prefixes. */
  karutaPrefix  Boolean @default(false)
  /** Frame drawn on cards that do not have one of their own. */
  defaultFrameId Int @default(0)
}

model PrintCounter {
  variantId String      @id
  variant   CardVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  nextPrint Int         @default(1)
}

/** A bot DM that should disappear. Messages with no row are swept as old mail. */
model EphemeralMessage {
  id        String   @id
  channelId String
  expiresAt DateTime
}

model Drop {
  id        String     @id @default(cuid())
  guildId   String
  channelId String
  messageId String     @unique
  createdAt    DateTime   @default(now())
  expiresAt    DateTime
  expiryPosted Boolean    @default(false)
  /** Player who dropped. They can take a card back during the protection window. */
  dropperId    String?
  dropper      User?      @relation(fields: [dropperId], references: [id], onDelete: SetNull)
  slots        DropSlot[]

  @@index([guildId])
}

model DropSlot {
  id          String       @id @default(cuid())
  dropId      String
  drop        Drop         @relation(fields: [dropId], references: [id], onDelete: Cascade)
  position    Int
  variantId   String
  variant     CardVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quality     CardQuality
  /** Null uses the server's default frame when the drop is shown. */
  frameId     Int?
  claimedById String?
  claimedBy   User?        @relation(fields: [claimedById], references: [id], onDelete: SetNull)
  cardId      String?      @unique
  card        Card?        @relation(fields: [cardId], references: [id], onDelete: SetNull)
  /** Grab line has been posted. Stays false during snipe protection until the dropper grabs or the window ends. */
  announced   Boolean      @default(false)

  @@unique([dropId, position])
}